#!/usr/bin/env bash
# Print the Ansible Vault password from Bitwarden.
#
# Ansible runs this because ANSIBLE_VAULT_PASSWORD_FILE (mise.toml) points at an executable file.
# The password is the custom field "password" on the Bitwarden note below. It needs an unlocked
# vault: run `export BW_SESSION="$(bw unlock --raw)"` first.
set -euo pipefail

item="ansible_vault_password_file_local_iac"
field="password"

if ! command -v bw > /dev/null; then
  echo "vault-pass: the Bitwarden CLI (bw) is not installed." >&2
  exit 1
fi

if [[ -z "${BW_SESSION:-}" ]]; then
  echo "vault-pass: Bitwarden is locked. Run: export BW_SESSION=\"\$(bw unlock --raw)\"" >&2
  exit 1
fi

password="$(
  bw get item "$item" --nointeraction \
    | jq -r --arg field "$field" '.fields[]? | select(.name == $field) | .value'
)"

if [[ -z "$password" ]]; then
  echo "vault-pass: no custom field \"$field\" on the Bitwarden item \"$item\"." >&2
  exit 1
fi

printf '%s\n' "$password"
